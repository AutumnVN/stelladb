---
// @ts-nocheck
import Card from '@/components/Card.astro';
import SearchableGrid from '@/components/SearchableGrid.astro';
import Layout from '@/layouts/Layout.astro';

export async function getStaticPaths() {
    const DATA_URL = 'https://raw.githubusercontent.com/AutumnVN/ss-data/refs/heads/main/ascension.json';
    const data = await fetch(DATA_URL).then((res) => res.json());

    return Object.keys(data).flatMap((groupId) =>
        Object.keys(data[groupId].diff).map((diffId) => ({
            params: { groupId, diffId },
            props: { group: data[groupId], diff: data[groupId].diff[diffId] },
        })),
    );
}

const {
    params: { groupId, diffId },
    props: { group, diff },
} = Astro;

const emoji = {
    Aqua: '💧',
    Ignis: '🔥',
    Terra: '⛰️',
    Ventus: '🌪️',
    Lux: '☀️',
    Umbra: '🌙',
    None: '⬜',
};

if (!group || !diff) {
    throw Astro.redirect('/404');
}

const embedLines = [`Weak: ${diff.weakTo.map((e) => e + emoji[e]).join(', ')}`, `Resist: ${diff.resistTo.map((e) => e + emoji[e]).join(', ')}`, `${Object.keys(diff.monster).length} monsters`];

const embed = JSON.stringify({
    component: {
        type: 17,
        accent_color: 6750105,
        components: [
            { type: 9, components: [{ type: 10, content: [`## **[${diff.name}](${Astro.url.href})**`, ...embedLines].join('  \n') }], accessory: { type: 11, media: { url: `https://raw.githubusercontent.com/AutumnVN/ssassets/refs/heads/main/export/assets/assetbundles/icon/mapchallenge/${diff.icon}.webp` } } },
        ],
    },
});
---

<Layout title={`${diff.name} | stelladb`} image={`https://raw.githubusercontent.com/AutumnVN/ssassets/refs/heads/main/export/assets/assetbundles/icon/mapchallenge/${diff.icon}.webp`} description={`Weak: ${diff.weakTo.map((e) => e + emoji[e]).join(', ')}, Resist: ${diff.resistTo.map((e) => e + emoji[e]).join(', ')}`} pagefindIgnore={true} embed={embed}>
    <SearchableGrid placeholder={`Search ${diff.name} monsters by id/name/weakto/resistto`} noResultsText="No ascension monster found.">
        {
            Object.entries(diff.monster).map(([id, monster]) => (
                <div class="card-item" data-id={id} data-name={monster.name} data-weakto={monster.weakTo.join(', ')} data-resistto={monster.resistTo}>
                    <Card href={`/ascension/${groupId}/${diffId}/${id}`} name={monster.name} desc={`Weak: ${monster.weakTo.map((e) => e + emoji[e]).join(', ')}`} desc2={`Resist: ${monster.resistTo}${emoji[monster.resistTo]}`} image={`https://raw.githubusercontent.com/AutumnVN/ssassets/refs/heads/main/export/assets/assetbundles/icon/monster/${monster.icon}.webp`} inset={-30} charClass={monster.type !== 'Normal' && monster.type} />
                </div>
            ))
        }
    </SearchableGrid>
</Layout>
