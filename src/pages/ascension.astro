---
// @ts-nocheck
import Card from '@/components/Card.astro';
import SearchableGrid from '@/components/SearchableGrid.astro';
import Layout from '@/layouts/Layout.astro';
import { fetchJson } from '@/scripts/fetchJson.js';

const DATA_URL = 'https://raw.githubusercontent.com/AutumnVN/ss-data/refs/heads/main/ascension.json';

const data = await fetchJson(DATA_URL);

---

<Layout title="Ascension | stelladb" pagefindIgnore={true}>
    <SearchableGrid placeholder="Search ascension groups by id/name/weakto" noResultsText="No ascension group found.">
        {
            Object.entries(data).map(([id, group]) => (
                <div class="card-item" data-id={id} data-name={group.name} data-weakto={group.weakTo.join(', ')}>
                    <Card href={`/ascension/${id}`} name={group.name} weak={group.weakTo} image={`https://raw.githubusercontent.com/AutumnVN/ssassets/refs/heads/main/export/assets/assetbundles/icon/mapchallenge/${group.icon}.webp`} />
                </div>
            ))
        }
    </SearchableGrid>
</Layout>
