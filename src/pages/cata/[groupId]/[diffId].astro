---
// @ts-nocheck
import Card from '@/components/Card.astro';
import SearchableGrid from '@/components/SearchableGrid.astro';
import Layout from '@/layouts/Layout.astro';

export async function getStaticPaths() {
    const DATA_URL = 'https://raw.githubusercontent.com/AutumnVN/ss-data/refs/heads/main/cata.json';
    const data = await fetch(DATA_URL).then((res) => res.json());

    return Object.keys(data).flatMap((groupId) =>
        Object.keys(data[groupId].diff).map((diffId) => ({
            params: { groupId, diffId },
            props: { group: data[groupId], diff: data[groupId].diff[diffId] },
        })),
    );
}

const {
    params: { groupId, diffId },
    props: { group, diff },
} = Astro;

if (!group || !diff) {
    throw Astro.redirect('/404');
}

const embedLines = [`Weak: ${diff.weakTo.join(', ')}`, `Resist: ${diff.resistTo.join(', ')}`];

const embed = JSON.stringify({
    component: {
        type: 17,
        accent_color: 6750105,
        components: [{ type: 9, components: [{ type: 10, content: [`## **[${diff.name}](${Astro.url.href})**`, ...embedLines].join('  \n') }], accessory: { type: 11, media: { url: `https://raw.githubusercontent.com/AutumnVN/ssassets/refs/heads/main/export/assets/assetbundles/icon/mapchallenge/${diff.icon}.webp` } } }],
    },
});
---

<Layout title={`${diff.name} | ${group.name} | stelladb`} image={`https://raw.githubusercontent.com/AutumnVN/ssassets/refs/heads/main/export/assets/assetbundles/icon/mapchallenge/${diff.icon}.webp`} description={`Weak: ${diff.weakTo.join(', ')}, Resist: ${diff.resistTo.join(', ')}`} pagefindIgnore={true} embed={embed}>
    <SearchableGrid placeholder={`Search ${diff.name} zones by id/name/weakto`} noResultsText="No cataclysm zone found.">
        {
            Object.entries(diff.zone).map(([zoneId, zone]) => {
                const boss = zone.monster.find((m) => m.boss);

                return (
                    <div class="card-item" data-id={zoneId} data-name={zone.name} data-weakto={zone.weakTo.join(', ')}>
                        <Card
                            href={`/cata/${groupId}/${diffId}/${zoneId}`}
                            name={zone.name}
                            weak={zone.weakTo.length ? zone.weakTo : 'None'}
                            image={boss ? `https://raw.githubusercontent.com/AutumnVN/ssassets/refs/heads/main/export/assets/assetbundles/icon/monster/${boss.icon}.webp` : `https://raw.githubusercontent.com/AutumnVN/ssassets/refs/heads/main/export/assets/assetbundles/icon/mapchallenge/${diff.icon}.webp`}
                            inset={-30}
                            charClass={boss && boss.type !== 'Normal' && boss.type}
                        />
                    </div>
                );
            })
        }
    </SearchableGrid>
</Layout>
