---
// @ts-nocheck
import Card from '@/components/Card.astro';
import SearchableGrid from '@/components/SearchableGrid.astro';
import Layout from '@/layouts/Layout.astro';
import { fetchJson } from '@/scripts/fetchJson.js';

const DATA_URL = 'https://raw.githubusercontent.com/AutumnVN/ssleaderboard/refs/heads/main/meta.json';

const data = await fetchJson(DATA_URL);
---

<Layout title="Leaderboard | stelladb" pagefindIgnore={true}>
    <SearchableGrid placeholder="Search leaderboard by id/name/season/boss" noResultsText="No leaderboard found.">
        {
            Object.entries(data).map(([id, data]) => {
                const isBB = /^bb/.test(id);
                const season = id.match(/\d+/)?.[0];
                const name = isBB ? `Boss Blitz S${season}` : `Finale Echoing S${season}`;
                const floors = data.floor;
                const firstIcon = Object.values(floors)[0]?.icon;

                return (
                    <div
                        class={'card-item'}
                        data-id={id}
                        data-name={name}
                        data-season={season}
                        data-boss={Object.values(floors)
                            .map((f) => f.name)
                            .join(' ')}
                    >
                        <Card
                            href={`/lb/${id}`}
                            name={name}
                            desc={Object.values(floors)
                                .map((f) => f.name)
                                .join(', ')}
                            image={`https://raw.githubusercontent.com/AutumnVN/ssassets/refs/heads/main/export/assets/assetbundles/icon/${isBB ? 'mapchallenge' : 'monster'}/${firstIcon}.webp`}
                            inset={-30}
                        />
                    </div>
                );
            })
        }
    </SearchableGrid>
</Layout>
