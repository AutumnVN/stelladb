---
// @ts-nocheck
import Card from '@/components/Card.astro';
import SearchableGrid from '@/components/SearchableGrid.astro';
import Layout from '@/layouts/Layout.astro';

const DATA_URL = 'https://raw.githubusercontent.com/AutumnVN/ss-data/refs/heads/main/cata.json';

const data = await fetch(DATA_URL).then((res) => res.json());
---

<Layout title="Cataclysm Survivor | stelladb" pagefindIgnore={true}>
    <SearchableGrid placeholder="Search cataclysm difficulties by id/name" noResultsText="No cataclysm difficulty found.">
        {
            Object.entries(data).map(([id, group]) => (
                <div class="card-item" data-id={id} data-name={group.name}>
                    <Card href={`/cata/${id}`} name={group.name} image={`https://raw.githubusercontent.com/AutumnVN/ssassets/refs/heads/main/export/assets/assetbundles/icon/mapchallenge/${group.icon}.webp`} />
                </div>
            ))
        }
    </SearchableGrid>
</Layout>
