---
// @ts-nocheck
import Card from '@/components/Card.astro';
import SearchableGrid from '@/components/SearchableGrid.astro';
import Layout from '@/layouts/Layout.astro';

const DATA_URL = 'https://raw.githubusercontent.com/AutumnVN/StellaSoraData/refs/heads/main/blitz.json';

const data = await fetch(DATA_URL).then((res) => res.json());

const emoji = {
    Aqua: '💧',
    Ignis: '🔥',
    Terra: '⛰️',
    Ventus: '🌪️',
    Lux: '☀️',
    Umbra: '🌙',
    None: '⬜',
};
---

<Layout title="Boss Blitz | stelladb" pagefindIgnore={true}>
    <SearchableGrid placeholder="Search bosses by id/name/weakto/resistto" noResultsText="No boss found.">
        {
            Object.entries(data).map(([id, blitz]) => (
                <div class="card-item" data-id={id} data-name={blitz.name} data-weakto={blitz.weakTo.join(', ')} data-resistto={blitz.resistTo}>
                    <Card href={`/blitz/${id}`} name={blitz.name} desc={`Weak: ${blitz.weakTo.map((e) => e + emoji[e]).join(', ')}`} desc2={`Resist: ${blitz.resistTo}${emoji[blitz.resistTo]}`} image={`https://raw.githubusercontent.com/AutumnVN/ssassets/refs/heads/main/export/assets/assetbundles/icon/mapchallenge/${blitz.icon}.webp`} inset={-30} />
                </div>
            ))
        }
    </SearchableGrid>
</Layout>

<script>
    // @ts-nocheck
    const SCOREBOSSCONTROL_URL = 'https://raw.githubusercontent.com/AutumnVN/StellaSoraData/refs/heads/main/EN/bin/ScoreBossControl.json';
    const scoreBossControl = await fetch(SCOREBOSSCONTROL_URL).then((res) => res.json());
    const currentSeason = Object.values(scoreBossControl).filter((season) => Date.now() >= new Date(season.StartTime) && Date.now() <= new Date(season.EndTime))[0];
    const upcomingSeasons = Object.values(scoreBossControl).filter((season) => Date.now() < new Date(season.StartTime) && season.LevelGroup?.join(',') !== '2,3');
    const cardItems = document.querySelectorAll('.card-item');

    cardItems.forEach((cardItem) => {
        const id = cardItem.getAttribute('data-id');
        if (currentSeason?.LevelGroup?.includes(+id)) {
            cardItem.querySelector('.card-border').classList.add('current');
        } else if (upcomingSeasons.some((season) => season.LevelGroup.includes(+id))) {
            cardItem.querySelector('.card-border').classList.add('upcoming');
        }
    });
</script>

<style is:global>
    .card-border {
        &.current {
            border: var(--green) 5px solid;
            border-radius: 5px;
        }

        &.upcoming {
            border: var(--blue) 5px solid;
            border-radius: 5px;
        }
    }
</style>
