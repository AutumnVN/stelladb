---
// @ts-nocheck
import Card from '@/components/Card.astro';
import SearchableGrid from '@/components/SearchableGrid.astro';
import Layout from '@/layouts/Layout.astro';

const DATA_URL = 'https://raw.githubusercontent.com/AutumnVN/StellaSoraData/refs/heads/main/raid.json';

const data = await fetch(DATA_URL).then((res) => res.json());

const emoji = {
    Aqua: '💧',
    Ignis: '🔥',
    Terra: '⛰️',
    Ventus: '🌪️',
    Lux: '☀️',
    Umbra: '🌙',
    None: '⬜',
};
---

<Layout title="Raid | stelladb" pagefindIgnore={true}>
    <SearchableGrid placeholder="Search bosses by id/name/season/weakto/resistto" noResultsText="No boss found.">
        {
            Object.entries(data).map(([id, raid]) => (
                <div class="card-item" data-id={id} data-name={raid.name} data-season={raid.season} data-weakto={raid.weakTo.join(' ')} data-resistto={raid.resistTo}>
                    <Card href={`/raid/${id}`} name={raid.name} desc={`Weak: ${raid.weakTo.map((e) => e + emoji[e]).join(', ')}`} desc2={`Resist: ${raid.resistTo}${emoji[raid.resistTo]}`} image={`https://raw.githubusercontent.com/AutumnVN/ssassets/refs/heads/main/export/assets/assetbundles/icon/monster/${raid.icon}.webp`} inset={-30} />
                </div>
            ))
        }
    </SearchableGrid>
</Layout>

<script>
    // @ts-nocheck
    const ACTIVITY_URL = 'https://raw.githubusercontent.com/AutumnVN/StellaSoraData/refs/heads/main/EN/bin/Activity.json';
    const activity = await fetch(ACTIVITY_URL).then((res) => res.json());
    const raidActivity = Object.values(activity).filter((act) => act.ActivityType === 7);
    const currentRaid = raidActivity.filter((raid) => Date.now() >= new Date(raid.StartTime) && Date.now() <= new Date(raid.EndTime))[0];
    const upcomingRaids = raidActivity.filter((raid) => Date.now() < new Date(raid.StartTime));
    console.log('currentRaid', currentRaid);
    console.log('upcomingRaids', upcomingRaids);
    const cardItems = document.querySelectorAll('.card-item');

    cardItems.forEach((cardItem) => {
        const id = cardItem.getAttribute('data-id');
        if (currentRaid?.Id - 459000 === +id) {
            cardItem.querySelector('.card-border').classList.add('current');
        } else if (upcomingRaids.some((raid) => raid.Id - 459000 === +id)) {
            cardItem.querySelector('.card-border').classList.add('upcoming');
        }
    });
</script>

<style is:global>
    .card-border {
        &.current {
            border: var(--green) 5px solid;
            border-radius: 5px;
        }

        &.upcoming {
            border: var(--blue) 5px solid;
            border-radius: 5px;
        }
    }
</style>
