---
// @ts-nocheck
import Card from '@/components/Card.astro';
import SearchableGrid from '@/components/SearchableGrid.astro';
import Layout from '@/layouts/Layout.astro';

export async function getStaticPaths() {
    const DATA_URL = 'https://raw.githubusercontent.com/AutumnVN/ss-data/refs/heads/main/arena.json';
    const data = await fetch(DATA_URL).then((res) => res.json());

    return Object.keys(data).map((groupId) => ({
        params: { groupId },
        props: { group: data[groupId] },
    }));
}

const {
    params: { groupId },
    props: { group },
} = Astro;

const emoji = {
    Aqua: '💧',
    Ignis: '🔥',
    Terra: '⛰️',
    Ventus: '🌪️',
    Lux: '☀️',
    Umbra: '🌙',
    None: '⬜',
};

if (!group) {
    throw Astro.redirect('/404');
}

const embedLines = [`Weak: ${group.weakTo}${emoji[group.weakTo]}`, group.openDayDesc].filter(Boolean);

const embed = JSON.stringify({
    component: {
        type: 17,
        accent_color: 6750105,
        components: [
            { type: 9, components: [{ type: 10, content: [`## **[${group.name}](${Astro.url.href})**`, ...embedLines].join('  \n') }], accessory: { type: 11, media: { url: `https://raw.githubusercontent.com/AutumnVN/ssassets/refs/heads/main/export/assets/assetbundles/image/uibg/${group.icon}.webp` } } },
        ],
    },
});
---

<Layout title={`${group.name} | stelladb`} image={`https://raw.githubusercontent.com/AutumnVN/ssassets/refs/heads/main/export/assets/assetbundles/image/uibg/${group.icon}.webp`} description={`Weak: ${group.weakTo}${emoji[group.weakTo]}, ${group.openDayDesc}`} pagefindIgnore={true} embed={embed}>
    <SearchableGrid placeholder={`Search ${group.name} difficulties by id/name/weakto`} noResultsText="No arena difficulty found.">
        {
            Object.entries(group.diff).map(([id, diff]) => (
                <div class="card-item" data-id={id} data-name={diff.name} data-weakto={diff.weakTo}>
                    <Card href={`/arena/${groupId}/${id}`} name={diff.name} desc={`Weak: ${group.weakTo}${emoji[group.weakTo]}`} image={`https://raw.githubusercontent.com/AutumnVN/ssassets/refs/heads/main/export/assets/assetbundles/image/uibg/${group.icon}.webp`} />
                </div>
            ))
        }
    </SearchableGrid>
</Layout>
